pipeline {
  // Run only on an agent prepared with the versions documented in README.md.
  agent { label 'bioinformatics-ci' }

  options {
    timestamps()
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds(abortPrevious: true)
  }

  stages {
    stage('Environment') {
      steps {
        // Record tool versions before any test changes the workspace.
        sh 'bash content/resources/week-07/scripts/run_fast_ci.sh versions'
      }
    }

    stage('Lint') {
      steps {
        // Parse the Week 6 Nextflow project without executing biological tools.
        sh 'bash content/resources/week-07/scripts/run_fast_ci.sh lint'
      }
    }

    stage('Pipeline contract') {
      steps {
        // Use nf-test and process stubs to exercise the five-stage dataflow.
        sh 'bash content/resources/week-07/scripts/run_fast_ci.sh contract'
      }
    }

    stage('Tiny FASTQ sandbox') {
      steps {
        // Run the real two-process sandbox plus file and unittest checks.
        sh 'bash content/resources/week-07/scripts/run_fast_ci.sh sandbox'
      }
    }

    stage('Expected failure') {
      steps {
        // Prove that the QC gate rejects three reads when four are required.
        sh 'bash content/resources/week-07/scripts/run_fast_ci.sh negative'
      }
    }
  }

  post {
    // Reports and small outputs remain available even when a stage fails.
    always {
      script {
        if (fileExists('build/test-results/nf-test.xml')) {
          junit testResults: 'build/test-results/nf-test.xml'
        }
        if (fileExists('build/sandbox/read_qc.tsv')) {
          archiveArtifacts artifacts: 'build/sandbox/**,build/expected-failure/**', fingerprint: true
        }
      }
    }
  }
}
